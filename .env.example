# NÃO publique seu arquivo .env real.
DEMO_ONLY=true
COOKIE_SECURE=true
DATABASE_PATH=/app/data/qg-renda.sqlite3
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Asaas Sandbox: sem comunicação com ambiente de produção
ASAAS_SANDBOX_ENABLED=true
ASAAS_SANDBOX_OUTBOUND_ENABLED=false
ASAAS_SANDBOX_TRANSFER_TESTS_ENABLED=false
# Defina estes segredos apenas no Render quando tiver conta Sandbox:
# ASAAS_SANDBOX_API_KEY=
# ASAAS_SANDBOX_WEBHOOK_TOKEN=

# Woovi: integração não publicada, ativação SOMENTE em Sandbox
WOOVI_SANDBOX_ENABLED=false
WOOVI_SANDBOX_OUTBOUND_ENABLED=false
# Criar AppID exclusivo em app.woovi-sandbox.com (não pôr a chave no GitHub)
# WOOVI_SANDBOX_APP_ID=
# Chave pública RSA do Sandbox, obtida da documentação oficial da Woovi
# WOOVI_SANDBOX_WEBHOOK_PUBLIC_KEY_PEM=
